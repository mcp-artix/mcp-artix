# API REST GLPI — copiar a .env (no versionar).
# Base: sin barra final; si GLPI está en subruta, inclúyala (ej. https://host/glpi).
GLPI_BASE_URL=http://localhost:8081
# En GLPI: Configuración → API: generar App-Token y User-Token para el usuario API.
GLPI_APP_TOKEN=REEMPLAZAR_TOKEN_APLICACION
GLPI_USER_TOKEN=REEMPLAZAR_USER_TOKEN
