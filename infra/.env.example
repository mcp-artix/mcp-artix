# Copiar a .env en esta carpeta: cp .env.example .env
# Valores de EJEMPLO para laboratorio — no usar en producción.

# --- Oracle (gvenzl/oracle-free) ---
ORACLE_PASSWORD=CambiarEnLaboratorio123
ORACLE_DATABASE=FREEPDB1
ORACLE_HTTP_PORT=8080
ORACLE_PORT=1521

# --- MariaDB (GLPI) ---
MARIADB_ROOT_PASSWORD=CambiarRootMariaDB123
MARIADB_DATABASE=glpi
MARIADB_USER=glpi
MARIADB_PASSWORD=CambiarGlpiDb123

# --- GLPI ---
GLPI_HTTP_PORT=8081
# Versión de imagen: alinear con docker-compose.yml
GLPI_IMAGE_TAG=latest

# --- GitLab en SERVIDOR DEDICADO (recomendado; no levantar contenedor gitlab en el Mac) ---
# URL pública de su instancia (HTTPS). Solo referencia para scripts y documentación local.
GITLAB_SERVER_URL=https://gitlab.empresa.interna
# Host SSH de GitLab para remotes git@host:... (opcional)
GITLAB_REMOTE_SSH_HOST=gitlab.empresa.interna
# Copiar aquí el token de registro del Runner solo si usa scripts locales; preferir registrar sin guardar token en disco
GITLAB_RUNNER_REGISTRATION_TOKEN=REEMPLAZAR_TOKEN_DE_REGISTRO

# --- GitLab CE en Docker (perfil: gitlab) — solo si NO usa servidor dedicado; muy exigente en RAM ---
GITLAB_HTTP_PORT=8929
GITLAB_SSH_PORT=2222
GITLAB_HOSTNAME=localhost
GITLAB_OMNIBUS_CONFIG_EXTERNAL_URL=http://localhost:8929

# --- GitLab Runner (perfil: runner) — contenedor runner local; registre contra GITLAB_SERVER_URL ---

# --- MCP (opcional, perfil: mcp) ---
# Si ejecuta MCP Oracle/APEX como contenedor del compose, use host "oracle" (red interna Docker):
# ORACLE_CONNECTION_MCP=oracle://usuario_lab:***@oracle:1521/FREEPDB1
# Si ejecuta MCP en host (sin compose), configure ORACLE_CONNECTION en mcp/oracle-apex/.env

# Puertos reservados para evolución HTTP/SSE (no usados por stdio en esta iteración):
MCP_ORACLE_APEX_PORT=3100
MCP_GLPI_PORT=3101

# --- GLPI API (MCP / integración; no es lo mismo que credenciales web de GLPI) ---
# Para MCP en host:
GLPI_API_URL=http://localhost:8081
# Para perfil mcp en compose (contenedor a contenedor):
GLPI_API_URL_MCP=http://glpi
GLPI_API_TOKEN=REEMPLAZAR_APP_TOKEN
GLPI_USER_TOKEN=REEMPLAZAR_USER_TOKEN
